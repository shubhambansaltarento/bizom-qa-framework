# Template for .env. Copy to .env and fill in the blanks.
BIZOM_BASE_URL=https://devarun.bizomdev.in
LOGIN_PATH=/users/login
BIZOM_USERNAME=
BIZOM_PASSWORD=

# Page URLs
ADD_PERMISSION_URL=https://devarun.bizomdev.in/urlpermissions/addpermissions

# Password the sales test sets for the distributor manager it picks.
DM_NEW_PASSWORD=

# Distributor manager account for role-based UI tests (its password is DM_NEW_PASSWORD).
DM_USERNAME=

# Automation users (usernames starting with e2e., see data/automationUsers.ts).
# Their passwords are this prefix + digits, new on every run (the app refuses a user's last 3 passwords).
E2E_USER_PASSWORD_PREFIX=Web@

# Discovery framework (config/discovery-config.json holds everything else).
# HEADLESS=false opens a visible browser (needed for manual login / MFA).
HEADLESS=true
# Login timeout in milliseconds (automated and manual login).
LOGIN_TIMEOUT=60000

# Permission targets: which roles / designations / users the permission tests load.
# Defaults live in utils/config/permissions/permission-targets.json; setting one of these
# replaces that group's list. Comma-separated ids or names, "*" = all, "" = skip the group.
# PERMISSION_ROLES=ADMIN
# PERMISSION_DESIGNATIONS=DSM
# PERMISSION_USERS=Pradeep Kumar,Guru
